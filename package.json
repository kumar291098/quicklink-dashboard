{
  "name": "quicklink-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first desktop link manager built with React, Spring Boot, and Electron.",
  "author": "kumar291098",
  "main": "electron/main.js",
  "scripts": {
    "frontend": "cd frontend && npm run dev",
    "backend": "cd backend && .\\gradlew.bat bootRun",
    "electron": "electron ./electron/main.js",
    "desktop": "npm run build:frontend && npm run build:backend && npm run build:runtime && npm run electron",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && .\\gradlew.bat bootJar",
    "build:runtime": "powershell -ExecutionPolicy Bypass -File .\\scripts\\copy-java-runtime.ps1",
    "dist": "npm run build:frontend && npm run build:backend && npm run build:runtime && electron-builder"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.quicklink.dashboard",
    "productName": "QuickLink Dashboard",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/build/libs/backend-0.0.1-SNAPSHOT.jar",
        "to": "backend/backend-0.0.1-SNAPSHOT.jar"
      },
      {
        "from": "runtime/jre",
        "to": "runtime/jre"
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
